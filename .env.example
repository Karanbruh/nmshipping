# Local dev: Vite middleware reads this for /api/cricket-news
VITE_RSS2JSON_API_KEY=your_key_here

# Vercel serverless API (api/cricket-news.js) — set this in Vercel Project Settings → Environment Variables
RSS2JSON_API_KEY=your_key_here

# News images come from ESPNcricinfo (India) + The Hindu cricket RSS via rss2json
# (Google News RSS does not include article thumbnails)
